<?xml version="1.0" encoding="utf-8"?>
<!--
  Nova Converter launcher icon — adaptive foreground (108dp canvas, safe zone 66dp).

  Concept: cards wala "source ➜ target" language icon me bhi repeat hota hai.
  Ek rounded-square container hai jisme do overlapping media chips hain —
  peeche video (play triangle), aage audio (waveform bars) — beech me chhota
  arrow. Isse pehle wale "generic circular arrow + bolt" se zyada pata chalta
  hai ki app exactly kya karta hai: media ko badalna.

  Saare shapes viewport ke andar (18..90 = adaptive safe zone) hain.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── back plate (subtle dark glass, rounded) ── -->
    <path
        android:pathData="M26,30 L82,30 A8,8 0 0 1 90,38 L90,70 A8,8 0 0 1 82,78 L26,78 A8,8 0 0 1 18,70 L18,38 A8,8 0 0 1 26,30 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.14" />

    <!-- ── VIDEO chip (left, slightly back) ── -->
    <path
        android:pathData="M30,38 L58,38 A6,6 0 0 1 64,44 L64,64 A6,6 0 0 1 58,70 L30,70 A6,6 0 0 1 24,64 L24,44 A6,6 0 0 1 30,38 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.20" />
    <!-- play triangle -->
    <path
        android:pathData="M37,47 L37,61 L50,54 Z"
        android:fillColor="#FFFFFF" />

    <!-- ── AUDIO chip (right, foreground — waveform bars) ── -->
    <path
        android:pathData="M56,38 L80,38 A6,6 0 0 1 86,44 L86,64 A6,6 0 0 1 80,70 L56,70 A6,6 0 0 1 50,64 L50,44 A6,6 0 0 1 56,38 Z"
        android:fillColor="#FFFFFF" />
    <!-- waveform: 3 bars (equalizer) -->
    <path
        android:pathData="M59,52 L61.4,52 A1,1 0 0 1 62.4,53 L62.4,55 A1,1 0 0 1 61.4,56 L59,56 A1,1 0 0 1 58,55 L58,53 A1,1 0 0 1 59,52 Z"
        android:fillColor="#1B2559" />
    <path
        android:pathData="M65,48 L67.4,48 A1,1 0 0 1 68.4,49 L68.4,59 A1,1 0 0 1 67.4,60 L65,60 A1,1 0 0 1 64,59 L64,49 A1,1 0 0 1 65,48 Z"
        android:fillColor="#1B2559" />
    <path
        android:pathData="M71,51 L73.4,51 A1,1 0 0 1 74.4,52 L74.4,56 A1,1 0 0 1 73.4,57 L71,57 A1,1 0 0 1 70,56 L70,52 A1,1 0 0 1 71,51 Z"
        android:fillColor="#1B2559" />

    <!-- ── conversion arrow (chips ke upar, center-bottom) ── -->
    <path
        android:pathData="M38,72 L58,72 L58,68.5 L65,73.5 L58,78.5 L58,75 L38,75 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.92" />
</vector>