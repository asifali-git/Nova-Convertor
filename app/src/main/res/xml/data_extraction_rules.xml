<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules (API 31+): conversion history me user ki file
  names/paths hote hain — wo kahin bhi transfer nahi hone chahiye.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nova_history.xml" />
        <exclude domain="file" path="nova" />
        <exclude domain="file" path="nova_in" />
        <exclude domain="file" path="wm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nova_history.xml" />
        <exclude domain="file" path="nova" />
        <exclude domain="file" path="nova_in" />
        <exclude domain="file" path="wm" />
    </device-transfer>
</data-extraction-rules>
